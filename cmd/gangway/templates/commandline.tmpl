<!DOCTYPE html>
<html lang="ru">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0"/>
  <title>{{ .AppName }} — {{ .ClusterName }}</title>

  <!-- CSS  -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.100.2/css/materialize.min.css">

  <!-- Prism -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/prism.min.js" integrity="sha256-jTGzLAqOAcOL+ALD2f2tvFY7fs6dwkOeo88xiuVHaRk=" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/components/prism-bash.min.js" integrity="sha256-Ch5rv5tgAdVMCh7Wqb0UOcXkQAHNFSezi+0v/0z6xfw=" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/components/prism-yaml.min.js" integrity="sha256-pxsoS7PqPuy6D5T0Dq2PEXKJ5SRlIkdG8hpoMxQ0YlM=" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/themes/prism-tomorrow.min.css" integrity="sha256-4S9ufRr1EqaUFFeM9/52GH68Hs1Sbvx8eFXBWpl8zPI=" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/plugins/toolbar/prism-toolbar.min.css" integrity="sha256-xY7/SUa769r0PZ1ytZPFj2WqnOZYaYSKbX1hVTiQlcA=" crossorigin="anonymous" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/plugins/toolbar/prism-toolbar.min.js" integrity="sha256-OvKYJLcYRP3ZIPilT03rynyZfkdGFwzCwU82NB4/AT4=" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.0/clipboard.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.14.0/plugins/copy-to-clipboard/prism-copy-to-clipboard.min.js" integrity="sha256-s+Z1sBUQFaaw7xeAnWb/oS8gBM4MEKiEWMRJ0p+/xbc=" crossorigin="anonymous"></script>
   <style>
       :root { color-scheme: light; --bg: #f5f7fb; --surface: #fff; --text: #172033; --muted: #5f6b7a; --nav: #172554; --primary: #2563eb; }
       [data-theme="dark"] { color-scheme: dark; --bg: #0f172a; --surface: #172033; --text: #e5e7eb; --muted: #aab4c3; --nav: #020617; --primary: #60a5fa; }
       body { background: var(--bg); color: var(--text); transition: background .2s, color .2s; }
       nav { background: var(--nav); }
         .theme-toggle-item { height: 64px; display: flex; align-items: center; }
         .language-button { background: transparent; border: 1px solid rgba(255,255,255,.45); border-radius: 4px; color: #fff; cursor: pointer; line-height: 1.2; margin-left: 8px; padding: 7px 10px; }
        .theme-toggle { background: transparent; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; color: #fff; cursor: pointer; display: inline-flex; align-items: center; line-height: 1.2; margin: 0 0 0 8px; padding: 7px 12px; white-space: nowrap; }
         .command-toolbar { display: flex; justify-content: flex-end; margin: 8px 0; }
         .copy-button { margin: 0; }
        .os-tabs { display: flex; gap: 8px; margin: 18px 0 8px; }
        .os-tab { border: 1px solid var(--primary); border-radius: 4px; background: transparent; color: var(--primary); cursor: pointer; padding: 8px 14px; }
        .os-tab.active { background: var(--primary); color: #fff; }
        .os-panel { display: none; clear: both; }
        .os-panel.active { display: block; }
         .command-block { position: relative; }
         .download-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 8px; }
         .download-tab { border: 1px solid var(--primary); border-radius: 4px; background: transparent; color: var(--primary); cursor: pointer; padding: 8px 14px; }
         .download-tab.active { background: var(--primary); color: #fff; }
         .download-panel { display: none; }
         .download-panel.active { display: block; }
         .login-code-block, .login-command-block { background: #111827; color: #f8fafc; border-radius: 6px; padding: 14px; overflow-x: auto; }
         .login-code-block code { color: #facc15; font: 700 1.5rem monospace; letter-spacing: .12em; }
         .access-card { background: var(--surface); border: 1px solid var(--muted); border-radius: 8px; margin: 18px 0; padding: 18px; }
         .access-card h6 { color: var(--primary); font-weight: 700; margin-top: 0; }
         .utility-links { line-height: 2.2; }
         .utility-links a { display: inline-block; margin-right: 10px; white-space: nowrap; }
         .instruction-note { border-left: 4px solid var(--primary); padding: 8px 12px; background: rgba(37,99,235,.08); }
        .muted { color: var(--muted); }
        html[lang="ru"] [data-lang="en"], html[lang="en"] [data-lang="ru"] { display: none; }
        .token-status, .claims-details { background: var(--surface); border: 1px solid var(--muted); border-radius: 8px; padding: 16px; margin: 20px 0; overflow-wrap: anywhere; }
        .token-status { padding: 10px 14px; margin: 14px 0; }
        .token-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin: 0; }
        .token-summary p { margin: 0; }
        .token-help { margin-top: 10px; }
        .token-help summary { cursor: pointer; color: var(--primary); }
        .token-help p { margin: 10px 0 0; }
        .claims-details summary { cursor: pointer; font-weight: 600; }
         .claims-details dl { display: flex; flex-wrap: wrap; gap: 8px; position: relative; margin: 14px 0; }
         .claims-details dt { font-family: monospace; font-size: 13px; border: 1px dashed var(--muted); border-radius: 5px; padding: 4px 8px; cursor: help; }
         .claims-details dt:focus { outline: 2px solid var(--primary); outline-offset: 2px; }
         .claims-details dd { display: none; position: absolute; top: 100%; left: 0; z-index: 10; width: min(440px, 100%); margin: 6px 0 0; padding: 12px; background: var(--surface); color: var(--text); border: 1px solid var(--muted); border-radius: 6px; box-shadow: 0 4px 12px rgba(0,0,0,.2); font-size: 14px; line-height: 1.5; }
         .claims-details dt:hover + dd, .claims-details dt:focus + dd, .claims-details dd:hover { display: block; }
        .token-status time, .token-status output { font-weight: 600; }
        .company-brand { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-weight: 600; }
        .company-brand img { width: 34px; height: 34px; object-fit: contain; vertical-align: middle; }
        .company-brand img { filter: brightness(0) invert(1); }
        .cluster-name { color: var(--primary); font-weight: 700; white-space: nowrap; }
        .site-footer { margin-top: 48px; padding: 20px 0; text-align: center; color: var(--muted); }
      .code-toolbar {
          margin-bottom: 2em;
      }
  </style>
</head>
    <body>
        <nav role="navigation">
            <div class="nav-wrapper container"><a id="logo-container" href="#" class="brand-logo company-brand">{{ if .CompanyLogo }}<img src="{{ .CompanyLogo }}" alt="{{ .CompanyName }}">{{ end }}<span>{{ .CompanyName }}</span></a>
            <ul class="right hide-on-med-and-down">
                <li class="theme-toggle-item"><button class="language-button" type="button" data-language-toggle aria-label="Сменить язык">EN</button><button class="theme-toggle" type="button" data-theme-toggle aria-label="Сменить тему">☾ Тёмная тема</button></li>
                <li><form method="post" action="{{ .HTTPPath }}/logout" style="margin:0"><input type="hidden" name="csrf_token" value="{{ .LogoutCSRF }}"><button type="submit" style="background:none;border:0;color:#fff;cursor:pointer;font:inherit;padding:0 15px;height:64px"><span data-lang="ru">Выйти</span><span data-lang="en">Log out</span></button></form></li>
            </ul>

            <ul id="nav-mobile" class="side-nav">
                <li><a href="#">JWT-токен</a></li>
            </ul>
            <a href="#" data-activates="nav-mobile" class="button-collapse"><i class="material-icons">menu</i></a>
            </div>
        </nav>
        <div class="container">
            <h4 class="header center darken-3">
                <span data-i18n="welcome">Добро пожаловать</span>, {{ .Username }}!
            </h4>
             <section class="token-status" aria-label="ID token">
               <div class="token-summary">
                 <p><span data-lang="ru">Действителен до:</span><span data-lang="en">Expires:</span> <time id="token-expiry"></time></p>
                 <p><span data-lang="ru">Осталось:</span><span data-lang="en">Remaining:</span> <output id="token-remaining"></output></p>
               </div>
               <details class="token-help">
                 <summary><span data-lang="ru">Подробнее о сроке действия</span><span data-lang="en">More about token lifetime</span></summary>
                  <p class="muted" data-lang="ru">Время указано в часовом поясе вашего устройства. kubectl и Lens с поддержкой OIDC могут автоматически получить новый ID token через refresh token.</p>
                  <p class="muted" data-lang="en">Times use your device's time zone. OIDC-enabled kubectl and Lens clients can automatically obtain a new ID token using the refresh token.</p>
                 <a href="{{ .HTTPPath }}/login"><span data-lang="ru">Войти повторно</span><span data-lang="en">Sign in again</span></a>
               </details>
             </section>
             <details class="claims-details">
             <summary>
                 <span data-i18n="claims">Данные пользователя, полученные от провайдера идентификации:</span>
             </summary>
             <dl>
               <dt>iss / aud</dt><dd><span data-lang="ru">Кто выдал токен / для какого клиента он выпущен. API server проверяет оба значения.</span><span data-lang="en">Token issuer / intended audience. The API server validates both.</span></dd>
               <dt>sub</dt><dd><span data-lang="ru">Уникальный идентификатор пользователя у провайдера; это не обязательно логин.</span><span data-lang="en">Unique user identifier at the provider; not necessarily a login name.</span></dd>
               <dt>email / email_verified / name</dt><dd><span data-lang="ru">Почта, признак её подтверждения и отображаемое имя. В этом кластере email используется как имя пользователя Kubernetes.</span><span data-lang="en">Email, verification flag and display name. This cluster uses email as the Kubernetes username.</span></dd>
               <dt>groups</dt><dd><span data-lang="ru">Группы пользователя. Привязки RBAC определяют, какие права эти группы имеют в Kubernetes.</span><span data-lang="en">User groups. RBAC bindings determine their Kubernetes permissions.</span></dd>
               <dt>iat / exp / auth_time</dt><dd><span data-lang="ru">Время выдачи, окончания действия и входа пользователя — секунды с 1 января 1970 UTC. Дата окончания показана выше в понятном виде.</span><span data-lang="en">Issued-at, expiration and authentication times in seconds since January 1, 1970 UTC. Expiration is displayed above in readable form.</span></dd>
               <dt>jti / at_hash / c_hash</dt><dd><span data-lang="ru">Идентификатор токена и контрольные значения для проверки связи с access token и кодом авторизации. Вручную настраивать их не нужно.</span><span data-lang="en">Token identifier and hashes binding it to the access token and authorization code. No manual configuration is needed.</span></dd>
             </dl>
            <pre><code class="language-yaml">
{{- range $key, $value := .Claims -}}
    {{- if eq $key "groups" -}}
        {{- printf "%s:\n" $key -}}
        {{- range $groupName := $value -}}
            {{- printf "- \"%s\"\n" $groupName -}}
        {{- end -}}
    {{- else -}}
        {{- if eq (printf "%T" $value) "string" -}}
            {{- printf "%s: \"%s\"\n" $key $value -}}
        {{- else if eq (printf "%T" $value) "bool" -}}
            {{- if eq $value true -}}
                {{- printf "%s: true\n" $key -}}
            {{- else -}}
                {{- printf "%s: false\n" $key -}}
            {{ end }}
        {{- else if or (eq (printf "%T" $value) "float64") (eq (printf "%T" $value) "float32") -}}
            {{- printf "%s: %f\n" $key $value -}}
        {{- else -}}
            {{- printf "%s: %d\n" $key $value -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
             </code></pre>
             </details>
            <h5>
                <span data-i18n="access">Для доступа к кластеру Kubernetes</span> <strong class="cluster-name">{{ .ClusterName }}</strong> <span data-i18n="fromCommandLine">через командную строку настройте OpenID Connect (OIDC) одним из способов ниже.</span>
            </h5>
            <br>
            <p>
                <span data-i18n="install">Установите kubectl: в Windows —</span> <code>winget install --exact --id Kubernetes.kubectl</code> <span data-i18n="newPowerShell">(после установки откройте новый PowerShell), в macOS —</span> <code>brew install kubectl</code>. <span data-i18n="forLinux">Для Linux:</span>
            </p>
           <pre>
             <code class="language-bash">
curl -fLO "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
chmod +x ./kubectl
sudo mv ./kubectl /usr/local/bin/kubectl
             </code>
           </pre>
             <div class="download-tabs" role="tablist" aria-label="Формат доступа">
                 <button class="download-tab active" type="button" data-download-tab="tokens" data-i18n="tokensTab">Kubeconfig с токенами</button>
                 <button class="download-tab" type="button" data-download-tab="exec" data-i18n="execTab">Без токенов + login utility</button>
             </div>
             <div class="download-panel active" data-download-panel="tokens">
                  <p class="red-text text-darken-2"><strong data-lang="ru">Важно:</strong><strong data-lang="en">Important:</strong> <span data-lang="ru">kubeconfig содержит ID token, refresh token и client secret. Не отправляйте его в Git, чаты, тикеты или резервные копии.</span><span data-lang="en">This kubeconfig contains an ID token, refresh token, and client secret. Do not share it in Git, chats, tickets, or backups.</span></p>
                  <a href="{{ .HTTPPath }}/kubeconf" class="btn-large waves-effect waves-light blue" data-i18n="download">Скачать kubeconfig</a>
             </div>
             <div class="download-panel" data-download-panel="exec">
               <p><span data-lang="ru">Этот kubeconfig не содержит токены и client secret. Интерактивный вход выполняется один раз, после чего kubectl использует локальный кэш до истечения токена.</span><span data-lang="en">This kubeconfig contains no tokens or client secret. Sign in interactively once, then kubectl uses the local cache until the token expires.</span></p>
               <a href="{{ .HTTPPath }}/kubeconf?mode=exec" class="btn waves-effect waves-light blue" data-i18n="downloadExec">Скачать kubeconfig без токенов</a>
               <div class="access-card">
                 <h6 data-i18n="utilityTitle">Скачать gangway-login</h6>
                 <p class="muted" data-i18n="utilityText">Скачайте файл под свою ОС и сделайте его доступным в PATH под именем gangway-login.</p>
                 <p class="utility-links"><a href="{{ .HTTPPath }}/helper?platform=linux-amd64">Linux amd64</a><a href="{{ .HTTPPath }}/helper?platform=linux-arm64">Linux arm64</a><a href="{{ .HTTPPath }}/helper?platform=darwin-amd64">macOS Intel</a><a href="{{ .HTTPPath }}/helper?platform=darwin-arm64">macOS Apple Silicon</a><a href="{{ .HTTPPath }}/helper?platform=windows-amd64">Windows x64</a><a href="{{ .HTTPPath }}/helper?platform=windows-arm64">Windows ARM64</a></p>
               </div>
               <div class="access-card">
                 <h6 data-i18n="installTitle">Установка и запуск</h6>
                 <p class="instruction-note" data-i18n="installNote">Выберите свою ОС, скачайте helper выше и выполните команды.</p>
                 <h6>Linux / macOS</h6>
                 <p><span data-lang="ru">Замените OS-ARCH на платформу скачанного файла (например, linux-amd64 или darwin-arm64).</span><span data-lang="en">Replace OS-ARCH with your downloaded platform (for example linux-amd64 or darwin-arm64).</span></p>
                 <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="utility-unix-command" data-i18n="copy">Копировать</button></div>
                 <pre><code id="utility-unix-command" class="language-bash">chmod +x ./gangway-login-OS-ARCH
sudo mv ./gangway-login-OS-ARCH /usr/local/bin/gangway-login
kubectl --kubeconfig ./kubeconfig-exec.yaml get pods</code></pre>
                 <h6>Windows PowerShell</h6>
                 <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="utility-windows-command" data-i18n="copy">Копировать</button></div>
                 <pre><code id="utility-windows-command" class="language-powershell">New-Item -ItemType Directory -Force "$HOME\bin" | Out-Null
Move-Item .\gangway-login-windows-amd64.exe "$HOME\bin\gangway-login.exe"
$env:Path += ";$HOME\bin"
kubectl --kubeconfig .\kubeconfig-exec.yaml get pods</code></pre>
                 <p><span data-lang="ru">В Windows PATH выше действует в текущем окне PowerShell. Для постоянного использования добавьте каталог в пользовательский PATH. ARM64: <a href="{{ .HTTPPath }}/helper?platform=windows-arm64">скачать</a> и заменить имя файла в команде.</span><span data-lang="en">The Windows PATH change applies to this PowerShell window. Add the directory to your user PATH for persistent use. ARM64: <a href="{{ .HTTPPath }}/helper?platform=windows-arm64">download</a> and adjust the filename.</span></p>
               </div>
               <div class="access-card">
                 <h6 data-i18n="loginTitle">Первичный вход</h6>
                 <p data-i18n="utilityFlow">Один раз выполните эту команду в интерактивном терминале:</p>
                 <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="login-command" data-i18n="copy">Копировать</button></div>
                 <pre class="login-command-block"><code id="login-command">gangway-login --login --server https://login-k8s.gistech.mng --username {{ .Username }}</code></pre>
                 <p class="muted" data-i18n="utilityFlowAfter">После этого kubectl использует локальный кэш автоматически до истечения токена.</p>
                 <button class="btn waves-effect waves-light blue" type="button" id="generate-login-code" data-endpoint="{{ .HTTPPath }}/login-code" data-csrf="{{ .LogoutCSRF }}" data-i18n="generateCode">Получить одноразовый код</button>
                 <div id="login-code-result" hidden>
                   <p data-i18n="codeInstruction">Скопируйте этот код в окно, где запущен gangway-login --login:</p>
                   <pre class="login-code-block"><code id="login-code-value"></code></pre>
                 </div>
               </div>
             </div>
             <div id="legacy-commands">
              <div class="access-card">
                <h6 data-i18n="tokenCommandsTitle">Настройка kubeconfig с токенами</h6>
                <p class="instruction-note" data-i18n="tokenCommandsNote">Выберите свою операционную систему и скопируйте команды. ID token, refresh token и client secret будут записаны в kubeconfig.</p>
             <div class="os-tabs" role="tablist" aria-label="Операционная система">
                 <button class="os-tab active" type="button" data-os-tab="linux">Linux / macOS</button>
                 <button class="os-tab" type="button" data-os-tab="windows">Windows PowerShell</button>
             </div>
              <div class="os-panel active command-block" data-os-panel="linux">
                  <h6>Linux / macOS</h6>
                  <p class="muted" data-i18n="tokenLinuxNote">Выполните шаги по порядку. Временный CA-файл удаляется на последнем шаге.</p>
                  <h6 data-i18n="tokenStepCA">1. Сохранить CA</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="linux-token-ca" data-i18n="copy">Копировать</button></div>
                 <pre><code id="linux-token-ca" class="language-bash">cat &lt;&lt;'EOF' &gt; "ca-{{ .ClusterName }}.pem"
{{ .ClusterCA }}
EOF</code></pre>
                  <h6 data-i18n="tokenStepCluster">2. Добавить кластер</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="linux-token-cluster" data-i18n="copy">Копировать</button></div>
                 <pre><code id="linux-token-cluster" class="language-bash">kubectl config set-cluster "{{ .ClusterName }}" --server={{ .APIServerURL }} --certificate-authority="ca-{{ .ClusterName }}.pem" --embed-certs</code></pre>
                  <h6 data-i18n="tokenStepCredentials">3. Добавить OIDC credentials</h6>
                  <p class="red-text text-darken-2" data-i18n="tokenCredentialsWarning">Этот шаг содержит client secret, refresh token и ID token. Не сохраняйте команду в истории shell, Git, чатах или тикетах.</p>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="linux-token-credentials" data-i18n="copy">Копировать</button></div>
                 <pre><code id="linux-token-credentials" class="language-bash">kubectl config set-credentials "{{ .KubeCfgUser }}" \
  --auth-provider=oidc \
  --auth-provider-arg='idp-issuer-url={{ .IssuerURL }}' \
  --auth-provider-arg='client-id={{ .ClientID }}' \
  --auth-provider-arg='client-secret={{ .ClientSecret }}' \
  --auth-provider-arg='refresh-token={{ .RefreshToken }}' \
   --auth-provider-arg='id-token={{ .IDToken }}'</code></pre>
                  <h6 data-i18n="tokenStepContext">4. Создать и выбрать context</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="linux-token-context" data-i18n="copy">Копировать</button></div>
                 <pre><code id="linux-token-context" class="language-bash">kubectl config set-context "{{ .ClusterName }}" --cluster="{{ .ClusterName }}" --user="{{ .KubeCfgUser }}"
kubectl config use-context "{{ .ClusterName }}"</code></pre>
                  <h6 data-i18n="tokenStepCleanup">5. Удалить временный CA-файл</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="linux-token-cleanup" data-i18n="copy">Копировать</button></div>
                 <pre><code id="linux-token-cleanup" class="language-bash">rm "ca-{{ .ClusterName }}.pem"</code></pre>
             </div>
              <div class="os-panel command-block" data-os-panel="windows">
                  <h6>Windows PowerShell</h6>
                  <p class="muted" data-i18n="tokenWindowsNote">Выполните шаги по порядку. Временный CA-файл удаляется на последнем шаге.</p>
                  <h6 data-i18n="tokenStepCA">1. Сохранить CA</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="windows-token-ca" data-i18n="copy">Копировать</button></div>
                 <pre><code id="windows-token-ca" class="language-powershell">$ca = @'
{{ .ClusterCA }}
'@
$caPath = Join-Path (Get-Location).Path "ca-{{ .ClusterName }}.pem"
[IO.File]::WriteAllText($caPath, $ca, [Text.Encoding]::ASCII)</code></pre>
                  <h6 data-i18n="tokenStepCluster">2. Добавить кластер</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="windows-token-cluster" data-i18n="copy">Копировать</button></div>
                 <pre><code id="windows-token-cluster" class="language-powershell">kubectl config set-cluster "{{ .ClusterName }}" --server={{ .APIServerURL }} --certificate-authority="ca-{{ .ClusterName }}.pem" --embed-certs</code></pre>
                  <h6 data-i18n="tokenStepCredentials">3. Добавить OIDC credentials</h6>
                  <p class="red-text text-darken-2" data-i18n="tokenCredentialsWarning">Этот шаг содержит client secret, refresh token и ID token. Не сохраняйте команду в истории shell, Git, чатах или тикетах.</p>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="windows-token-credentials" data-i18n="copy">Копировать</button></div>
                 <pre><code id="windows-token-credentials" class="language-powershell">kubectl config set-credentials "{{ .KubeCfgUser }}" `
  --auth-provider=oidc `
  --auth-provider-arg="idp-issuer-url={{ .IssuerURL }}" `
  --auth-provider-arg="client-id={{ .ClientID }}" `
  --auth-provider-arg="client-secret={{ .ClientSecret }}" `
  --auth-provider-arg="refresh-token={{ .RefreshToken }}" `
  --auth-provider-arg="id-token={{ .IDToken }}"</code></pre>
                  <h6 data-i18n="tokenStepContext">4. Создать и выбрать context</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="windows-token-context" data-i18n="copy">Копировать</button></div>
                 <pre><code id="windows-token-context" class="language-powershell">kubectl config set-context "{{ .ClusterName }}" --cluster="{{ .ClusterName }}" --user="{{ .KubeCfgUser }}"
kubectl config use-context "{{ .ClusterName }}"</code></pre>
                  <h6 data-i18n="tokenStepCleanup">5. Удалить временный CA-файл</h6>
                  <div class="command-toolbar"><button class="copy-button btn blue" type="button" data-copy="windows-token-cleanup" data-i18n="copy">Копировать</button></div>
                 <pre><code id="windows-token-cleanup" class="language-powershell">Remove-Item "ca-{{ .ClusterName }}.pem"</code></pre>
             </div>
             </div>
         </div>
         </div>
          <footer class="site-footer"></footer>
         <script>
          document.querySelectorAll('.claims-details dt').forEach(function (label, index) {
            var tooltip = label.nextElementSibling;
            label.tabIndex = 0;
            tooltip.id = 'claim-help-' + index;
            tooltip.setAttribute('role', 'tooltip');
            label.setAttribute('aria-describedby', tooltip.id);
            label.addEventListener('click', function () { label.focus(); });
            label.addEventListener('keydown', function (event) { if (event.key === 'Escape') label.blur(); });
          });
          (function () {
            var expiry = Number({{ index .Claims "exp" }});
            function updateExpiry() {
              var ru = document.documentElement.lang !== 'en';
              var valid = Number.isFinite(expiry) && expiry > 0 && !isNaN(new Date(expiry * 1000).getTime());
              var date = document.getElementById('token-expiry');
              var remaining = document.getElementById('token-remaining');
              if (!valid) { date.textContent = ru ? 'Неизвестно' : 'Unknown'; remaining.textContent = '—'; return; }
              date.dateTime = new Date(expiry * 1000).toISOString();
              date.textContent = new Date(expiry * 1000).toLocaleString(ru ? 'ru-RU' : 'en-GB', { timeZoneName: 'short' });
              var seconds = Math.max(0, Math.floor(expiry - Date.now() / 1000));
              remaining.textContent = seconds === 0 ? (ru ? 'ID token истёк — требуется обновление токена' : 'ID token expired — token refresh required') : Math.floor(seconds / 86400) + (ru ? ' д ' : 'd ') + Math.floor(seconds % 86400 / 3600) + (ru ? ' ч ' : 'h ') + Math.floor(seconds % 3600 / 60) + (ru ? ' мин ' : 'm ') + seconds % 60 + (ru ? ' с' : 's');
            }
            updateExpiry();
            setInterval(updateExpiry, 1000);
          }());
          (function () {
            var root = document.documentElement;
            var saved = localStorage.getItem('gangway-theme');
            var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            var button;
             function apply(value) {
               root.setAttribute('data-theme', value);
               var en = root.lang === 'en';
               if (button) {
                 button.textContent = value === 'dark' ? (en ? '☀ Light theme' : '☀ Светлая тема') : (en ? '☾ Dark theme' : '☾ Тёмная тема');
                 button.setAttribute('aria-label', en ? 'Change theme' : 'Сменить тему');
               }
             }
             new MutationObserver(function () { apply(theme); }).observe(root, { attributes: true, attributeFilter: ['lang'] });
            document.addEventListener('DOMContentLoaded', function () { button = document.querySelector('[data-theme-toggle]'); apply(theme); button.addEventListener('click', function () { theme = theme === 'dark' ? 'light' : 'dark'; localStorage.setItem('gangway-theme', theme); apply(theme); }); });
            apply(theme);
           }());
           document.addEventListener('DOMContentLoaded', function () {
             document.querySelectorAll('[data-os-tab]').forEach(function (tab) { tab.addEventListener('click', function () { document.querySelectorAll('[data-os-tab], [data-os-panel]').forEach(function (item) { item.classList.remove('active'); }); tab.classList.add('active'); document.querySelector('[data-os-panel="' + tab.dataset.osTab + '"]').classList.add('active'); }); });
             document.querySelectorAll('[data-copy]').forEach(function (copyButton) { copyButton.addEventListener('click', function () { var code = document.getElementById(copyButton.dataset.copy); navigator.clipboard.writeText(code.textContent).then(function () { var old = copyButton.textContent; copyButton.textContent = language === 'ru' ? 'Скопировано' : 'Copied'; setTimeout(function () { copyButton.textContent = old; }, 1500); }); }); });
             var langButton = document.querySelector('[data-language-toggle]');
              var translations = { ru: { welcome: 'Добро пожаловать', claims: 'Данные пользователя, полученные от провайдера идентификации:', access: 'Для доступа к кластеру Kubernetes', fromCommandLine: 'через командную строку настройте OIDC одним из способов ниже.', install: 'Установите kubectl: в Windows —', newPowerShell: '(после установки откройте новый PowerShell), в macOS —', forLinux: 'Для Linux:', download: 'Скачать kubeconfig с токенами', downloadExec: 'Скачать kubeconfig без токенов', tokensTab: 'Kubeconfig с токенами', execTab: 'Без токенов + login utility', utilityTitle: 'Скачать gangway-login', utilityText: 'Скачайте файл под свою ОС и сделайте его доступным в PATH под именем gangway-login.', generateCode: 'Получить одноразовый код', tokenCommandsTitle: 'Настройка kubeconfig с токенами', tokenCommandsNote: 'Выберите свою операционную систему и скопируйте команды. ID token, refresh token и client secret будут записаны в kubeconfig.', tokenLinuxNote: 'Выполните шаги по порядку. Временный CA-файл удаляется на последнем шаге.', tokenStepCA: '1. Сохранить CA', tokenStepCluster: '2. Добавить кластер', tokenStepCredentials: '3. Добавить OIDC credentials', tokenCredentialsWarning: 'Этот шаг содержит client secret, refresh token и ID token. Не сохраняйте команду в истории shell, Git, чатах или тикетах.', tokenStepContext: '4. Создать и выбрать context', tokenStepCleanup: '5. Удалить временный CA-файл', tokenWindowsNote: 'Выполните шаги по порядку. Временный CA-файл удаляется на последнем шаге.', installTitle: 'Установка и запуск', installNote: 'Выберите свою ОС, скачайте helper выше и выполните команды.', loginTitle: 'Первичный вход', codeInstruction: 'Скопируйте этот код в окно, где запущен gangway-login --login:', utilityFlow: 'Один раз выполните эту команду в интерактивном терминале:', utilityFlowAfter: 'После этого kubectl использует локальный кэш автоматически до истечения токена.', selectOs: 'После установки kubectl выберите свою операционную систему и скопируйте весь блок команд.', copy: 'Копировать' }, en: { welcome: 'Welcome', claims: 'User information received from the identity provider:', access: 'To access the Kubernetes cluster', fromCommandLine: 'from the command line, configure OIDC using one of the options below.', install: 'Install kubectl: on Windows —', newPowerShell: '(open a new PowerShell after installation), in macOS —', forLinux: 'For Linux:', download: 'Download kubeconfig with tokens', downloadExec: 'Download kubeconfig without tokens', tokensTab: 'Kubeconfig with tokens', execTab: 'Without tokens + login utility', utilityTitle: 'Download gangway-login', utilityText: 'Download the file for your OS and put it on PATH as gangway-login.', generateCode: 'Generate one-time code', tokenCommandsTitle: 'Configure kubeconfig with tokens', tokenCommandsNote: 'Choose your operating system and copy the commands. The ID token, refresh token, and client secret will be written to kubeconfig.', tokenLinuxNote: 'Follow the steps in order. The temporary CA file is removed in the last step.', tokenStepCA: '1. Save the CA', tokenStepCluster: '2. Add the cluster', tokenStepCredentials: '3. Add OIDC credentials', tokenCredentialsWarning: 'This step contains the client secret, refresh token, and ID token. Do not save the command in shell history, Git, chats, or tickets.', tokenStepContext: '4. Create and select the context', tokenStepCleanup: '5. Remove the temporary CA file', tokenWindowsNote: 'Follow the steps in order. The temporary CA file is removed in the last step.', tokenStepCA: '1. Save the CA', tokenStepCluster: '2. Add the cluster', tokenStepCredentials: '3. Add OIDC credentials', tokenCredentialsWarning: 'This step contains the client secret, refresh token, and ID token. Do not save the command in shell history, Git, chats, or tickets.', tokenStepContext: '4. Create and select the context', tokenStepCleanup: '5. Remove the temporary CA file', installTitle: 'Installation and login', installNote: 'Choose your OS, download the helper above, and run the commands.', loginTitle: 'Initial login', codeInstruction: 'Paste this code into the terminal where gangway-login --login is running:', utilityFlow: 'Run this command once in an interactive terminal:', utilityFlowAfter: 'kubectl will use the protected local cache automatically until the token expires.', selectOs: 'After installing kubectl, select your operating system and copy the entire command block.', copy: 'Copy' } };
             function applyLanguage(lang) { document.documentElement.lang = lang; Object.keys(translations[lang]).forEach(function (key) { document.querySelectorAll('[data-i18n="' + key + '"]').forEach(function (item) { item.textContent = translations[lang][key]; }); }); if (langButton) langButton.textContent = lang === 'ru' ? 'RU' : 'EN'; }
             var language = localStorage.getItem('gangway-language') || 'ru'; applyLanguage(language);
              if (langButton) langButton.addEventListener('click', function () { language = language === 'ru' ? 'en' : 'ru'; localStorage.setItem('gangway-language', language); applyLanguage(language); });
              document.querySelectorAll('[data-download-tab]').forEach(function (tab) { tab.addEventListener('click', function () { document.querySelectorAll('[data-download-tab], [data-download-panel]').forEach(function (item) { item.classList.remove('active'); }); tab.classList.add('active'); document.querySelector('[data-download-panel="' + tab.dataset.downloadTab + '"]').classList.add('active'); document.getElementById('legacy-commands').hidden = tab.dataset.downloadTab !== 'tokens'; }); });
              var codeButton = document.getElementById('generate-login-code');
              if (codeButton) codeButton.addEventListener('click', function () { var form = new URLSearchParams(); form.set('csrf_token', codeButton.dataset.csrf); fetch(codeButton.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: form.toString() }).then(function (response) { if (!response.ok) throw new Error('HTTP ' + response.status); return response.text(); }).then(function (code) { document.getElementById('login-code-value').textContent = code.trim(); document.getElementById('login-code-result').hidden = false; }).catch(function (error) { document.getElementById('login-code-value').textContent = 'Ошибка: ' + error.message; document.getElementById('login-code-result').hidden = false; }); });
           });
        </script>
